# DocuMind Backend Environment Configuration
APP_NAME=DocuMind API
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated list for local frontend development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Configuration ('mock' for free offline testing, 'openai' for live model calls)
LLM_PROVIDER=mock

# OpenAI Configuration (Set your actual key in backend/.env when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0